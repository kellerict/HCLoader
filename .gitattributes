# Windows starter files of the portable build: always CRLF (cmd.exe/WSH); build_portable.ps1
# normalises them again when copying.
scripts/portable/*.cmd text eol=crlf
scripts/portable/*.vbs text eol=crlf
scripts/portable/*.txt text eol=crlf

# Keep source archives (GitHub zipball / git archive, used by the self-update) small:
# screenshots and previews are only for README/wiki and stay in the repository.
docs/screenshots/** export-ignore
docs/wiki/images/** export-ignore
docs/icon-preview.png export-ignore

# Inno Setup script: CRLF like the Windows starters (ISCC reads it as ANSI, keep it ASCII); the
# included message file (*.isi) is UTF-8 with BOM
installer/*.iss text eol=crlf
installer/*.isi text eol=crlf
